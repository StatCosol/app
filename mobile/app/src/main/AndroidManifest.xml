<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Bring the kiosk back after a reboot; see KioskBootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- allowClearUserData="false": Settings is reachable from the locked kiosk
         so staff can fix Wi-Fi without the admin PIN, and lock-task whitelisting
         is package-level — there is no way to expose only the Wi-Fi screen. That
         put Apps > Storage > Clear data within reach of anyone at the gate, which
         would wipe the device token, the admin PIN and any queued punches and
         leave the kiosk asking for an install token nobody there can supply. The
         app itself cannot be uninstalled (Device Owner); this closes the other
         way to achieve the same thing. See KioskLock.blockDestructiveSettings
         for the factory-reset and safe-mode halves. -->
    <application
        android:name=".AttendanceApp"
        android:allowBackup="false"
        android:allowClearUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatcompyAttendance"
        android:usesCleartextTraffic="false"
        tools:replace="android:allowBackup">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Token entry / device bootstrap. Also the kiosk's HOME entry: it
             already decides where to go (attendance when registered, token
             entry when not), so it is the right target for both a tap and a
             boot. -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:label="@string/setup_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- HOME is what actually keeps a kiosk up. Without it, a screen
                 off/on cycle leaves the device on the OEM launcher with the
                 kiosk alive but backgrounded — reproducible on the Samsung —
                 and a reboot leaves it there indefinitely. As HOME, the system
                 returns here instead, and starts it at boot by definition.
                 Declaring the filter only makes the app ELIGIBLE; it becomes
                 the launcher when an operator (or device-owner provisioning)
                 selects it, so a handset used for anything else is unaffected. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".kiosk.KioskActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:keepScreenOn="true"
            android:label="@string/kiosk_title" />

        <!-- FaceDesk — the full-screen attendance kiosk + admin enrollment.
             keepScreenOn so an unattended kiosk never sleeps mid-shift and
             stops capturing. -->
        <activity
            android:name=".facedesk.FaceDeskAttendanceActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:keepScreenOn="true"
            android:label="FaceDesk Attendance" />
        <activity
            android:name=".facedesk.FaceDeskEnrollmentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:keepScreenOn="true"
            android:label="FaceDesk Enrollment" />
        <activity
            android:name=".facedesk.FaceDeskEnrollPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="FaceDesk Enrollment" />

        <!-- Restart the kiosk after a reboot. Secondary to the HOME filter
             above, which the system honours by definition; this covers the case
             where the kiosk is not the selected launcher. -->
        <receiver
            android:name=".kiosk.KioskBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Device-owner admin. When set as Device Owner, the kiosk whitelists
             itself for lock task so screen pinning fully blocks Home/Recents. -->
        <receiver
            android:name=".kiosk.KioskDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
