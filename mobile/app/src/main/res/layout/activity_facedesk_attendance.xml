<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/fdPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Alignment guide: keeps the worker centered for a clean face crop. -->
    <View
        android:layout_width="260dp"
        android:layout_height="330dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_face_oval"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/fdTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@drawable/bg_kiosk_top_strip"
        android:text="@string/facedesk_look_at_camera" />

    <TextView
        android:id="@+id/fdResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold"
        android:background="@drawable/bg_kiosk_scrim"
        android:text="" />
</FrameLayout>
