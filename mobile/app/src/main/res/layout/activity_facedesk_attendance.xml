<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/fdPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="260dp"
        android:layout_height="330dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_face_oval"
        android:importantForAccessibility="no" />

    <include layout="@layout/include_kiosk_header" />

    <TextView
        android:id="@+id/fdTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_kiosk_top_strip"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:text="@string/facedesk_look_at_camera"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fdResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_kiosk_scrim"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingVertical="24dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <include layout="@layout/include_kiosk_success_overlay" />
</FrameLayout>
