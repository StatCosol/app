<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Face alignment guide. Centered on the preview; thick white stroke
         makes it visible in low-light factory gates. -->
    <View
        android:id="@+id/faceOval"
        android:layout_width="340dp"
        android:layout_height="430dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_face_oval" />

    <!-- Bottom brand/branch/clock strip. Keeping it at the foot leaves the
         camera and face guide clear while the worker follows prompts. -->
    <LinearLayout
        android:id="@+id/headerStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_kiosk_top_strip"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/headerBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_name"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:longClickable="true"
                android:padding="8dp" />

            <TextView
                android:id="@+id/headerBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCE0E0E0"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="Unit 1 — Main Gate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/headerClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                tools:text="09:14 AM" />

            <TextView
                android:id="@+id/headerDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCE0E0E0"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="Thu, 15 May" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#80000000"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:text="@string/kiosk_look_at_camera" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#DDE8F0FF"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Waiting for enrollment ticket..." />
    </LinearLayout>

    <!-- Direction arrow shown during HEAD_TURN liveness challenges -->
    <TextView
        android:id="@+id/tvDirectionArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:textSize="96sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#AA000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:visibility="gone"
        android:text="←" />

    <!-- Full-screen scrim + branded card. Hidden by default; shown after a
         successful punch and auto-dismissed after a few seconds. -->
    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_kiosk_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/successCard"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_kiosk_card">

            <!-- Brand header strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_kiosk_header"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_shield_check"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/brand_name"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="14sp"
                    android:letterSpacing="0.04"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/successBadgeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brand_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    tools:text="LOGIN" />
            </LinearLayout>

            <!-- Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="22dp">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp">

                    <ImageView
                        android:id="@+id/successBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_badge_in"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/successBadgeIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_white"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/successTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/ink_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="Login recorded" />

                <TextView
                    android:id="@+id/successName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink_secondary"
                    android:textSize="15sp"
                    android:gravity="center"
                    tools:text="Suresh Mahajan" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_time_pill"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/successTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        tools:text="09:12 AM • 14 May" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/brand_powered_by"
                    android:textColor="@color/ink_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
