<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force Light theme on the kiosk so the branded card / dialog stay
         readable even when the device is set to dark mode. -->
    <style name="Theme.StatcompyAttendance" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/ink_primary</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/Theme.StatcompyAttendance.Dialog</item>
    </style>

    <style name="Theme.StatcompyAttendance.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/ink_primary</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="android:background">@color/surface_card</item>
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Statcompy.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Statcompy.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Statcompy.Dialog.Body</item>
        <item name="materialAlertDialogTitleIconStyle">@style/Statcompy.Dialog.TitleIcon</item>
        <item name="buttonBarPositiveButtonStyle">@style/Statcompy.Dialog.PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Statcompy.Dialog.NegativeButton</item>
    </style>

    <style name="ShapeAppearance.Statcompy.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Statcompy.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Statcompy.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Statcompy.Dialog.TitleIcon" parent="MaterialAlertDialog.Material3.Title.Icon">
        <item name="tint">@color/brand_primary</item>
    </style>

    <style name="Statcompy.Dialog.PositiveButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Statcompy.Dialog.NegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>
