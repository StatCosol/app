# Normalise line endings to LF in the repo (the app builds/deploys on Linux).
# Prevents the CRLF drift that made local prettier report thousands of
# "Delete ␍" errors. Existing files convert to LF the next time they're staged.
* text=auto eol=lf

# Binary assets — never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
*.tflite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
