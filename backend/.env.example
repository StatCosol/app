# ──────────────────────────────────────────────
# StatComPy Backend — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Variables marked (required) must be set.

# ── App ──────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000

# ── Database (required) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=changeme
DB_NAME=statcompy
DB_SSL=false                  # Set to 'true' for Azure PostgreSQL

# ── Auth (required) ─────────────────────────
# JWT_SECRET must be at least 20 characters
JWT_SECRET=change-this-to-a-random-secret-min-20-chars
# Access-token lifetime in seconds (default: 900 = 15 min); refresh token is 14 days
JWT_ACCESS_EXPIRES_SEC=900

# ── SMTP / Email ────────────────────────────
EMAIL_ENABLED=false           # Set to 'true' to enable outbound email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false             # 'true' for port 465 (SSL)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@statcosol.com
SMTP_FROM_NAME=StatCo Solutions
SMTP_FROM_EMAIL=noreply@statcosol.com

# ── Frontend / CORS ─────────────────────────
FRONTEND_URL=http://localhost:4200
# Comma-separated origins allowed in production
CORS_ORIGINS=https://statcosol.com

# ── Seeding ──────────────────────────────────
SKIP_BOOTSTRAP_SEED=false     # Set to 'true' in production

# Face attendance production controls
FACE_KIOSK_LIVE_ATTENDANCE_ENABLED=false
FACE_KIOSK_ACTIVATION_DELAY_SEC=10
FACE_MIN_MATCH_SCORE=0.72
FACE_MIN_MATCH_MARGIN=0.05
FACE_MIN_QUALITY_SCORE=0.75
FACE_DUPLICATE_THRESHOLD=0.72
FACE_LIVENESS_CHALLENGE_REQUIRED=true
FACE_PUNCH_REQUIRE_SERVER_PROBE=true
FACE_POST_LOGOUT_COOLDOWN_HOURS=8
MOBILE_DEVICE_INSTALL_TOKEN_TTL_MIN=60
FACE_MAX_OFFLINE_BACKLOG_HOURS=24
FACE_REJECTION_ALERT_WINDOW_MIN=15
FACE_REJECTION_ALERT_THRESHOLD=5
FACE_DEVICE_REJECTION_ALERT_THRESHOLD=10

# ── FaceDesk / face-svc / Azure ───────────────
# Optional embedding microservice (POST /embed). Required in production for quality gates.
FACE_SVC_URL=
FACE_SVC_API_KEY=
FACE_SVC_TIMEOUT_MS=15000
EMBEDDING_BACKEND=mobilefacenet

# Azure Face API — required for FACE_ONLY and FACE_THEN_BIOMETRIC identification modes.
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=
AZURE_FACE_API_VERSION=v1.0
AZURE_FACE_IDENTIFICATION=false

# FaceDesk cosine calibration anchors (percent → cosine mapping)
FD_COSINE_AT_100=0.95
FD_COSINE_AT_95=0.84
FD_COSINE_AT_90=0.78
FD_COSINE_AT_80=0.60
FD_MIN_MARGIN_COSINE=0.05

# Minimum minutes between one punch and the next for the same subject. Punches
# alternate IN/OUT per business day, so a second capture moments after the first
# records the worker as leaving the instant they arrived. 0 disables the check.
FD_MIN_PUNCH_GAP_MINUTES=3

# ── Admin ────────────────────────────────────
ADMIN_ALERT_EMAILS=           # Comma-separated admin notification emails
DEFAULT_SEED_PASSWORD=        # Password for seeded users (leave blank for auto-generated)

# ── AI / OpenAI ──────────────────────────────
# AES-256 encryption key for stored AI API keys (64 hex chars)
AI_ENCRYPTION_KEY=
